{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "adapters/**/*.ts",
    "cli/**/*.ts",
    "tests/**/*.ts",
    "benchmarks/**/*.ts",
    "tui/**/*.ts",
    "tui/**/*.tsx",
    "ui/**/*.ts",
    "webui/*.ts",
    "desktop/**/*.ts",
    "desktop/**/*.cts"
  ],
  "exclude": [
    "desktop/main.ts",
    "desktop/preload.cts"
  ]
}
