{
  "name": "alphion",
  "version": "0.4.0",
  "description": "A resource-shaped Agent runtime with durable sessions, deterministic provider routing, and Desktop JSONL RPC.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "alphion": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./openai-compatible": {
      "types": "./dist/adapters/model/openai-compatible.d.ts",
      "import": "./dist/adapters/model/openai-compatible.js"
    },
    "./deepseek": {
      "types": "./dist/adapters/model/deepseek.d.ts",
      "import": "./dist/adapters/model/deepseek.js"
    },
    "./local": {
      "types": "./dist/adapters/local/local-application.d.ts",
      "import": "./dist/adapters/local/local-application.js"
    },
    "./sqlite": {
      "types": "./dist/adapters/store/sqlite-store.d.ts",
      "import": "./dist/adapters/store/sqlite-store.js"
    },
    "./tools": {
      "types": "./dist/adapters/tools/index.d.ts",
      "import": "./dist/adapters/tools/index.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime.d.ts",
      "import": "./dist/src/runtime.js"
    },
    "./providers": {
      "types": "./dist/src/providers.d.ts",
      "import": "./dist/src/providers.js"
    },
    "./resources": {
      "types": "./dist/src/resources.d.ts",
      "import": "./dist/src/resources.js"
    },
    "./desktop": {
      "types": "./dist/desktop/index.d.ts",
      "import": "./dist/desktop/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/adapters",
    "dist/cli",
    "dist/tui",
    "dist/desktop",
    "alphion.bat",
    "alphion-icon.svg",
    "alphion-logo.svg",
    "alphion-wordmark.svg",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:static": "node scripts/verify-static.mjs",
    "test": "npm run build && npm run test:built",
    "test:built": "node --test dist/tests/foundation.test.js dist/tests/openai-compatible.test.js dist/tests/deepseek.test.js dist/tests/vault.test.js dist/tests/project-phase1.test.js dist/tests/sessions-v032.test.js dist/tests/v040.test.js dist/tests/desktop-rpc.test.js dist/tests/tui.test.js dist/tests/cli.test.js",
    "benchmark:built": "node dist/benchmarks/foundation.js",
    "smoke:built": "node scripts/verify-built.mjs",
    "cli": "node dist/cli/index.js",
    "tui": "node dist/cli/index.js tui",
    "smoke:live": "node dist/cli/live-smoke.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "ink": "^7.1.1",
    "openai": "^7.4.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
