{
  "name": "alphion",
  "version": "0.10.2",
  "description": "A multimodal multi-project Agent workbench with durable sessions, context usage, goals, and scheduling.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/desktop/main.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "alphion": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./openai-compatible": {
      "types": "./dist/adapters/model/openai-compatible.d.ts",
      "import": "./dist/adapters/model/openai-compatible.js"
    },
    "./deepseek": {
      "types": "./dist/adapters/model/deepseek.d.ts",
      "import": "./dist/adapters/model/deepseek.js"
    },
    "./local": {
      "types": "./dist/adapters/local/local-application.d.ts",
      "import": "./dist/adapters/local/local-application.js"
    },
    "./sqlite": {
      "types": "./dist/adapters/store/sqlite-store.d.ts",
      "import": "./dist/adapters/store/sqlite-store.js"
    },
    "./tools": {
      "types": "./dist/adapters/tools/index.d.ts",
      "import": "./dist/adapters/tools/index.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime.d.ts",
      "import": "./dist/src/runtime.js"
    },
    "./providers": {
      "types": "./dist/src/providers.d.ts",
      "import": "./dist/src/providers.js"
    },
    "./resources": {
      "types": "./dist/src/resources.d.ts",
      "import": "./dist/src/resources.js"
    },
    "./desktop": {
      "types": "./dist/desktop/index.d.ts",
      "import": "./dist/desktop/index.js"
    },
    "./webui": {
      "types": "./dist/webui/index.d.ts",
      "import": "./dist/webui/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/adapters",
    "dist/cli",
    "dist/tui",
    "dist/ui",
    "dist/webui",
    "dist/desktop",
    "assets",
    "electron-builder.yml",
    "alphion.bat",
    "alphion-icon.svg",
    "alphion-logo.svg",
    "alphion-wordmark.svg",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && npm run build:core && npm run build:desktop && npm run build:webui",
    "build:core": "tsc -p tsconfig.json",
    "build:desktop": "tsc -p desktop/tsconfig.json",
    "build:webui": "vite build --config webui/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p desktop/tsconfig.json --noEmit && tsc -p webui/tsconfig.json --noEmit",
    "verify:static": "node scripts/verify-static.mjs",
    "brand:generate": "electron scripts/generate-brand-assets.cjs",
    "test": "npm run build && npm run test:built",
    "test:built": "node --test dist/tests/foundation.test.js dist/tests/openai-compatible.test.js dist/tests/deepseek.test.js dist/tests/vault.test.js dist/tests/project-phase1.test.js dist/tests/sessions-v032.test.js dist/tests/v040.test.js dist/tests/v050-project-collaboration.test.js dist/tests/v060-session-fork.test.js dist/tests/v060-refresh.test.js dist/tests/v060-surface-fork.test.js dist/tests/v070-conversation.test.js dist/tests/v070-ui.test.js dist/tests/v080-compaction.test.js dist/tests/v080-goal-scheduler.test.js dist/tests/v080-migration.test.js dist/tests/v080-surface-branding.test.js dist/tests/provider-catalog.test.js dist/tests/provider-test.test.js dist/tests/v090-workspace.test.js dist/tests/v0100-context.test.js dist/tests/v0100-attachments.test.js dist/tests/v0102-recall-chat.test.js dist/tests/markdown.test.js dist/tests/webui.test.js dist/tests/desktop.test.js dist/tests/tui.test.js dist/tests/cli.test.js",
    "benchmark:built": "node dist/benchmarks/foundation.js",
    "smoke:built": "node scripts/verify-built.mjs",
    "cli": "node dist/cli/index.js",
    "tui": "node dist/cli/index.js tui",
    "desktop": "node scripts/prepare-desktop-runtime.mjs && electron .desktop-runtime/dist/desktop/main.js",
    "desktop:deps": "node scripts/prepare-desktop-runtime.mjs --install",
    "node:abi-smoke": "node scripts/node-abi-smoke.mjs",
    "desktop:abi-smoke": "electron scripts/electron-abi-smoke.cjs",
    "desktop:pack": "node scripts/prepare-desktop-runtime.mjs && electron-builder --win nsis portable --x64",
    "smoke:live": "node dist/cli/live-smoke.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "ink": "^7.1.1",
    "katex": "^0.16.27",
    "openai": "^7.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
